# =====================================================================
# LITMATE — ARCHIVO DE CONFIGURACIÓN DE EJEMPLO (.env.example)
# Copia este archivo como '.env' en la raíz y coloca tus credenciales.
# =====================================================================

# 1. Seguridad de Django
SECRET_KEY=tu_clave_secreta_aqui_generada_aleatoriamente
DEBUG=True

# 2. Base de Datos (True = SQLite local, False = MySQL / TiDB Cloud)
USE_SQLITE=True

# Configuración si usas base de datos MySQL / Cloud (Opcional si USE_SQLITE=True)
DB_NAME=litmate_db
DB_USER=root
DB_PASSWORD=tu_password
DB_HOST=127.0.0.1
DB_PORT=3306

# 3. Servicios de Inteligencia Artificial (LLM & Embeddings)
# Las claves siguientes son del chatbot legado; el asistente actual usa Ollama y Google Books.
GROQ_API_KEY=tu_groq_api_key_aqui
PINECONE_API_KEY=tu_pinecone_api_key_aqui
PINECONE_ENVIRONMENT=us-east-1
HF_TOKEN=tu_huggingface_token_aqui

# 4. Social Login (OAuth2 Google & GitHub)
GOOGLE_CLIENT_ID=tu_google_client_id
GOOGLE_CLIENT_SECRET=tu_google_client_secret
GITHUB_CLIENT_ID=tu_github_client_id
GITHUB_CLIENT_SECRET=tu_github_client_secret

# 5. Correo Electrónico (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu_correo@gmail.com
EMAIL_HOST_PASSWORD=tu_password_de_aplicacion_gmail
DEFAULT_FROM_EMAIL=LitMate <tu_correo@gmail.com>

# 6. Pasarelas de Pago (Mercado Pago, PayPal, Transbank)
MERCADOPAGO_ACCESS_TOKEN=tu_mercadopago_access_token
MERCADOPAGO_PUBLIC_KEY=tu_mercadopago_public_key
PAYPAL_CLIENT_ID=tu_paypal_client_id
PAYPAL_CLIENT_SECRET=tu_paypal_secret
TRANSBANK_COMMERCE_CODE=597055555532
TRANSBANK_API_KEY=579B532A7440BB063079DED94DE31EFEED4766B287BB80A9D827B8D19E79D045

# 7. Google Analytics
GOOGLE_ANALYTICS_ID=G-X2MN3MZSX6

# 8. Asistente IA actual. Copia estas variables a tu .env sin borrar las demás.
LITMATE_USE_GOOGLE_BOOKS_API=True
GOOGLE_BOOKS_API_KEY=tu_clave_google_books_aqui
GOOGLE_BOOKS_TIMEOUT=8
# Vacío admite libros en cualquier idioma; es restringe los resultados a español.
GOOGLE_BOOKS_LANGUAGE=
LITMATE_OLLAMA_URL=http://127.0.0.1:11434
LITMATE_LOCAL_MODEL=qwen3.5:9b-q4_K_M
LITMATE_LOCAL_GUARD_MODEL=qwen3.5:9b-q4_K_M
LITMATE_LOCAL_CONTEXT=16384
LITMATE_LOCAL_THINKING=False
LITMATE_LOCAL_ANSWER_TOKENS=3072
LITMATE_AI_TOTAL_TIMEOUT=360
LITMATE_AI_REQUIRE_BOOK_SOURCES=True
LITMATE_AI_BIBLIOGRAPHIC_FAST_PATH=True
LITMATE_AI_PUBLIC_DETAILS_FAST_PATH=True
LITMATE_AI_CATALOG_FALLBACK=True
LITMATE_AI_FAST_RECOMMENDATIONS=True
LITMATE_AI_LOCK_BACKEND=sqlite
LITMATE_AI_USE_OPENLIBRARY=True
LITMATE_AI_USE_WEB=True
# SearXNG es opcional; Google Books funciona sin Docker.
LITMATE_AI_USE_SEARXNG=False
LITMATE_SEARXNG_URL=http://127.0.0.1:8080
LITMATE_RAG_SEMANTIC=True
LITMATE_EMBED_MODEL=embeddinggemma:latest
# La voz Microsoft envía el texto al proveedor; activa sólo si quieres usarla.
LITMATE_TTS_ENABLED=False
LITMATE_TTS_TIMEOUT_SECONDS=20
